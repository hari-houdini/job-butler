{
  "name": "job-butler",
  "version": "0.1.0",
  "private": true,
  "description": "Job Butler: a Claude Code plugin with a deterministic TypeScript core CLI",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "cli": "node core/src/cli.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test --test-reporter=dot \"core/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "check:markers": "! git grep -nE '^(<<<<<<<|>>>>>>>)' -- . ':!*.jsonl'",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm run check:markers && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "22.20.5",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
