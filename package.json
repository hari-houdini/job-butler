{
  "name": "job-butler",
  "version": "1.0.0",
  "private": true,
  "description": "Job Butler: a Claude Code plugin with a deterministic TypeScript core CLI",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "cli": "node core/src/cli.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test --test-reporter=dot \"core/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "check:markers": "! git grep --cached -nE '^(<<<<<<<|>>>>>>>)' -- . ':!*.jsonl'",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm run check:markers && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.6",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2"
  }
}
